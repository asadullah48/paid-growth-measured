# Local-only configuration. Replace placeholders in your private .env file.
POSTGRES_USER=pgm
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=paid_growth
# Host port for the Docker database. Use 5433 if a local PostgreSQL service already uses 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pgm:replace-with-a-long-local-password@localhost:5432/paid_growth
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DEMO_PASSWORD=replace-with-a-unique-demo-password
